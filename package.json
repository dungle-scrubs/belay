{
  "name": "trevor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n store,blob,host,web -c blue,magenta,green,cyan \"pnpm --filter @trevor/session-store dev\" \"pnpm --filter @trevor/blob-store dev\" \"pnpm --filter @trevor/agent-host dev\" \"pnpm --filter @trevor/web dev\"",
    "dev:web": "pnpm --filter @trevor/web dev",
    "trevor": "pnpm --filter @trevor/cli start",
    "build": "pnpm -r build",
    "check:filenames": "tsx packages/repo-policy/src/cli.ts",
    "lint": "biome check . && pnpm check:filenames",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:web": "vitest run --project web",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:browser": "tsx tests/browser/run-browser-e2e.ts",
    "test-storybook": "pnpm --filter @trevor/web test-storybook",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@effect/vitest": "^0.29.0",
    "@playwright/test": "1.50.0",
    "@typescript/native-preview": "7.0.0-dev.20260621.1",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.9",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
