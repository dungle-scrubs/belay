{
  "name": "trevor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n store,blob,host,web -c blue,magenta,green,cyan \"pnpm --filter @trevor/session-store dev\" \"pnpm --filter @trevor/blob-store dev\" \"pnpm --filter @trevor/agent-host dev\" \"pnpm --filter @trevor/web dev\"",
    "dev:web": "pnpm --filter @trevor/web dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260621.1",
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3"
  }
}
